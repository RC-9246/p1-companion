[Unit]
Description=P1 read-only resource collector
After=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=45
TimeoutStartSec=45
ExecStart=/usr/bin/python3 -B /opt/p1-monitor/collector.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=p1-monitor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/p1-monitor
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=64M
TasksMax=16
CPUQuota=10%
Nice=10

[Install]
WantedBy=multi-user.target
